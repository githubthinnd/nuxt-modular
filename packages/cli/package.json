{
  "name": "@nuxt-modular/cli",
  "version": "1.0.1",
  "description": "Command line for nuxt-modular: scaffold extensions (make:extension, make:migration, ...) and validate manifests in CI.",
  "keywords": [
    "nuxt-modular",
    "nuxt",
    "cli",
    "scaffold",
    "generator",
    "validate",
    "extensions",
    "plugin-system"
  ],
  "license": "MIT",
  "author": "Nhữ Duy Thìn",
  "homepage": "https://github.com/githubthinnd/nuxt-modular#readme",
  "bugs": {
    "url": "https://github.com/githubthinnd/nuxt-modular/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/githubthinnd/nuxt-modular.git",
    "directory": "packages/cli"
  },
  "type": "module",
  "sideEffects": false,
  "bin": {
    "nuxt-modular": "./bin/nuxt-modular.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "build": "unbuild",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@nuxt-modular/core": "workspace:*",
    "pathe": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "unbuild": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
