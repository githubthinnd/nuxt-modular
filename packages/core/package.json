{
  "name": "@nuxt-modular/core",
  "version": "1.0.1",
  "description": "Framework-agnostic core of nuxt-modular: extension manifest schemas, registry, hook bus, migrations, seeders, SQL stores and semver checks.",
  "keywords": [
    "nuxt-modular",
    "extensions",
    "plugin-system",
    "manifest",
    "registry",
    "hooks",
    "migrations",
    "seeders",
    "sqlite",
    "postgresql",
    "mysql",
    "semver",
    "typescript"
  ],
  "license": "MIT",
  "author": "Nhữ Duy Thìn",
  "homepage": "https://github.com/githubthinnd/nuxt-modular#readme",
  "bugs": {
    "url": "https://github.com/githubthinnd/nuxt-modular/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/githubthinnd/nuxt-modular.git",
    "directory": "packages/core"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./runtime": {
      "types": "./dist/runtime.d.mts",
      "default": "./dist/runtime.mjs"
    },
    "./node": {
      "types": "./dist/node.d.mts",
      "default": "./dist/node.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "unbuild",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "jiti": "catalog:",
    "pathe": "catalog:",
    "tinyglobby": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@types/node": "catalog:",
    "mysql2": "^3.24.6",
    "pg": "^8.23.1",
    "typescript": "catalog:",
    "unbuild": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
