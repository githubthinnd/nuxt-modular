{
  "name": "@nuxt-modular/core",
  "version": "0.0.0",
  "description": "Framework-agnostic manifest contracts and validation for nuxt-modular extensions.",
  "license": "MIT",
  "author": "Nhữ Duy Thìn",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "keywords": [
    "nuxt",
    "modular",
    "extensions",
    "plugins",
    "manifest"
  ],
  "scripts": {
    "build": "unbuild",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "unbuild": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
