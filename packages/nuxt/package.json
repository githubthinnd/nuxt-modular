{
  "name": "nuxt-modular",
  "version": "1.2.0",
  "description": "A plugin and extension system for Nuxt: build modular, extensible apps with outlets, permissions, feature toggles, hooks and SQLite, PostgreSQL or MySQL migrations.",
  "keywords": [
    "nuxt",
    "nuxt-module",
    "nuxt3",
    "nuxt4",
    "vue",
    "modular",
    "modular-architecture",
    "plugin-system",
    "plugins",
    "extensions",
    "extensible",
    "slots",
    "outlet",
    "feature-flags",
    "feature-toggles",
    "permissions",
    "hooks",
    "migrations",
    "seeders",
    "sqlite",
    "postgresql",
    "mysql",
    "ssr",
    "typescript"
  ],
  "license": "MIT",
  "author": "Nhữ Duy Thìn",
  "homepage": "https://github.com/githubthinnd/nuxt-modular#readme",
  "bugs": {
    "url": "https://github.com/githubthinnd/nuxt-modular/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/githubthinnd/nuxt-modular.git",
    "directory": "packages/nuxt"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "bin": {
    "nuxt-modular": "./bin/nuxt-modular.mjs"
  },
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ]
    }
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "build": "nuxt-module-build prepare && nuxt-module-build build",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare",
    "typecheck": "nuxt-module-build prepare && vue-tsc -b --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@nuxt-modular/cli": "workspace:*",
    "@nuxt-modular/core": "workspace:*",
    "@nuxt/devtools-kit": "catalog:",
    "@nuxt/kit": "catalog:",
    "db0": "catalog:",
    "h3": "catalog:",
    "jiti": "catalog:",
    "pathe": "catalog:",
    "tinyglobby": "catalog:"
  },
  "peerDependencies": {
    "@electric-sql/pglite": "*",
    "@libsql/client": "*",
    "better-sqlite3": "*",
    "mysql2": "*",
    "pg": "*"
  },
  "peerDependenciesMeta": {
    "@electric-sql/pglite": {
      "optional": true
    },
    "@libsql/client": {
      "optional": true
    },
    "better-sqlite3": {
      "optional": true
    },
    "mysql2": {
      "optional": true
    },
    "pg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nuxt/cli": "catalog:",
    "@nuxt/module-builder": "catalog:",
    "@nuxt/schema": "catalog:",
    "@vue/test-utils": "catalog:",
    "happy-dom": "catalog:",
    "nitropack": "catalog:",
    "nuxt": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:",
    "vue-tsc": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
