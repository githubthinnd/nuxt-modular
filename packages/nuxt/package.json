{
  "name": "nuxt-modular",
  "version": "0.1.0",
  "description": "Turn a Nuxt app into an extensible host platform: plug-in extensions with outlets, navigation, permissions, pages and server hooks.",
  "license": "MIT",
  "author": "Nhữ Duy Thìn",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/githubthinnd/nuxt-modular.git",
    "directory": "packages/nuxt"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "nuxt",
    "nuxt-module",
    "modular",
    "extensions",
    "plugins",
    "slots",
    "outlet"
  ],
  "scripts": {
    "build": "nuxt-module-build prepare && nuxt-module-build build",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare",
    "typecheck": "nuxt-module-build prepare && vue-tsc -b --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@nuxt-modular/core": "workspace:*",
    "@nuxt/devtools-kit": "catalog:",
    "@nuxt/kit": "catalog:",
    "h3": "catalog:",
    "jiti": "catalog:",
    "pathe": "catalog:",
    "tinyglobby": "catalog:"
  },
  "devDependencies": {
    "@nuxt/cli": "catalog:",
    "@nuxt/module-builder": "catalog:",
    "@nuxt/schema": "catalog:",
    "@vue/test-utils": "catalog:",
    "happy-dom": "catalog:",
    "nitropack": "catalog:",
    "nuxt": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:",
    "vue-tsc": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
